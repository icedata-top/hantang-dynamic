{
  "name": "bilibili-dynamic-subscribe",
  "version": "5.3.2",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && ncc build .build/index.js -o dist",
    "typecheck": "tsc --noEmit",
    "start": "tsx dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome lint",
    "format": "biome format",
    "check": "biome check",
    "lint:fix": "biome lint --fix",
    "format:fix": "biome format --fix",
    "check:fix": "biome check --fix",
    "package": "pkg dist/index.js --out-path dist/executables/ --compress Gzip --targets node24-win-x64,node24-macos-x64,node24-macos-arm64,node24-linux-x64,node24-linux-arm64 --no-bytecode --public",
    "backfill-mission-ids": "tsx src/index.ts --backfill-mission-ids",
    "backfill-video-daily": "tsx src/index.ts --backfill-video-daily",
    "init-schema": "tsx src/index.ts --init-schema",
    "upgrade-video-history": "tsx src/index.ts --upgrade-video-history",
    "relation": "tsx src/index.ts --relation",
    "repair": "tsx src/index.ts --repair",
    "update-info": "tsx src/index.ts --update-info",
    "login-qr": "tsx src/scripts/login-qr.ts"
  },
  "dependencies": {
    "@ahmedrangel/rand-user-agent": "^2.0.23",
    "@prometheus-io/client": "^0.16.1",
    "axios": "^1.20.0",
    "axios-cookiejar-support": "^7.0.0",
    "cli-progress": "^3.12.0",
    "csv-parse": "^7.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "qrcode-terminal": "^0.12.0",
    "smol-toml": "^1.9.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@duckdb/node-api": "1.5.6-r.1",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/tough-cookie": "^4.0.5",
    "@vercel/ncc": "^0.45.0",
    "@yao-pkg/pkg": "^6.23.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
